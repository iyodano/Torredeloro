<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
    <meta name="theme-color" content="#0a0a0a">
    <meta name="description" content="Pizzería Torre del Oro: descubre nuestras pizzas, sus ingredientes y precios, enteras o por porción.">
    <title>Pizzería Torre del Oro</title>
    <link rel="preload" as="image" href="img/margherita.webp">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
            max-width: 100%;
        }

        html {
            scroll-behavior: smooth;
        }

        html, body {
            overflow-x: hidden;
            background-color: var(--background_color);
        }

        body {
            font-family: 'Segoe UI', system-ui, -apple-system, Roboto, sans-serif;
            color: #fff;
            -webkit-font-smoothing: antialiased;
        }

        :root {
            --background_color: #3c3d42;
            --oro: #f3b33d;
            --ancho-referencia: 800px;
            --ancho-total: min(90vw, var(--ancho-referencia));
            --alto-banner: 550px;
            --banner-desde-arriba: 95px;
            --alto-escena: calc(var(--banner-desde-arriba) + var(--alto-banner));
        }

        @media (max-width: 800px) {
            :root {
                --alto-banner: calc(600px * (var(--ancho-total) / 800px));
                --banner-desde-arriba: calc(75px * (var(--ancho-total) / 800px));
            }
        }

        /* ── Cabecera ── */
        .top-menu {
            width: 100%;
            height: 80px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 5vw;
            background: #0a0a0a;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            position: sticky;
            top: 0;
            z-index: 999;
        }

        .logo {
            color: var(--oro);
            font-size: clamp(1.2rem, 3vw, 1.8rem);
            font-weight: 800;
            letter-spacing: 2px;
            text-decoration: none;
        }

        .top-menu nav {
            display: flex;
            gap: 30px;
        }

        .top-menu nav a {
            color: white;
            text-decoration: none;
            font-size: 0.95rem;
            opacity: 0.75;
            transition: opacity 0.3s ease, color 0.3s ease;
        }

        .top-menu nav a:hover { opacity: 1; color: var(--oro); }

        @media (max-width: 700px) {
            .top-menu {
                height: auto;
                justify-content: center;
                padding: 20px;
            }
            .top-menu nav { display: none; }
            .logo {
                font-size: clamp(1rem, 5vw, 1.5rem);
                letter-spacing: 1.5px;
                white-space: nowrap;
                text-align: center;
            }
        }

        /* ── Hero ── */
        .hero {
            background-color: var(--background_color);
            display: flex;
            flex-direction: column;
            align-items: center;
            overflow-x: clip;
            overflow-y: visible;
            padding: 6px 0 0;
            scroll-margin-top: 80px;
        }

        /* ── Arco selector (rueda) ── */
        .arc-selector-wrap {
            width: min(100%, 1100px);
            margin: 0 auto -60px;
            position: relative;
            z-index: 20;
            pointer-events: none;
        }

        .arc-selector-wrap svg {
            width: 100%;
            height: auto;
            overflow: visible;
            display: block;
            pointer-events: none;
        }

        .arc-item {
            pointer-events: all;
            cursor: pointer;
            outline: none;
            -webkit-tap-highlight-color: transparent;
        }

        .arc-item text {
            font-size: var(--fs);
            font-weight: 500;
            fill: rgba(255,255,255,0.42);
            transition: fill .3s ease, font-size .3s ease;
        }
        .arc-item .nodo { fill: rgba(255,255,255,0.22); transition: fill .3s ease; }
        .arc-item .guia { stroke: rgba(255,255,255,0.12); transition: stroke .3s ease; }

        .arc-item:hover text,
        .arc-item:focus-visible text { fill: rgba(255,255,255,0.85); }
        .arc-item:focus-visible .nodo { fill: rgba(255,255,255,0.6); }

        .arc-item.activo { cursor: default; }
        .arc-item.activo text { fill: var(--oro); font-size: var(--fsA); font-weight: 700; }
        .arc-item.activo .nodo { fill: rgba(243,179,61,0.75); }
        .arc-item.activo .guia { stroke: rgba(243,179,61,0.45); }

        #arc-dot { filter: drop-shadow(0 0 6px rgba(243,179,61,0.55)); }

        /* ── Escena pizza ── */
        .pizza-scene {
            position: relative;
            width: var(--ancho-total);
            height: var(--alto-escena);
            margin: 0 auto;
            background-color: var(--background_color);
            overflow: hidden;
        }

        .pizza-clip {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: calc(var(--ancho-total) / 2);
            overflow: hidden;
            z-index: 1;
            pointer-events: auto;
            border-radius: 24px 24px 0 0;
            cursor: pointer;
            touch-action: pan-y;
            -webkit-tap-highlight-color: transparent;
        }

        .pizza-wrapper {
            position: absolute;
            top: 0;
            left: 0;
            width: var(--ancho-total);
            height: var(--ancho-total);
            will-change: transform;
            backface-visibility: hidden;
        }

        .pizza-wrapper img {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
            object-fit: contain;
            object-position: center;
            opacity: 0;
            pointer-events: none;
            transition: none;
            filter: drop-shadow(0 10px 25px rgba(0,0,0,0.25));
        }

        .pizza-wrapper img.active { opacity: 1; }

        /* Flechas laterales: toca izquierda = anterior, derecha = siguiente */
        .flecha {
            position: absolute;
            top: calc(var(--ancho-total) / 4);
            transform: translateY(-50%);
            z-index: 15;
            width: clamp(34px, 7vw, 46px);
            height: clamp(34px, 7vw, 46px);
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.18);
            background: rgba(10,10,10,0.45);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            color: #fff;
            display: grid;
            place-items: center;
            cursor: pointer;
            opacity: 0.55;
            transition: opacity .25s ease, background .25s ease, transform .25s ease, border-color .25s ease;
            -webkit-tap-highlight-color: transparent;
        }
        .flecha svg { width: 45%; height: 45%; }
        .flecha-izq { left: 4px; }
        .flecha-der { right: 4px; }
        .flecha:hover,
        .pizza-scene.lado-izq .flecha-izq,
        .pizza-scene.lado-der .flecha-der {
            opacity: 1;
            background: rgba(243,179,61,0.9);
            border-color: transparent;
            color: #111;
        }
        .flecha:active { transform: translateY(-50%) scale(0.92); }

        @keyframes pulsoIzq { 0%,100% { transform: translate(0,-50%); } 50% { transform: translate(-5px,-50%); } }
        @keyframes pulsoDer { 0%,100% { transform: translate(0,-50%); } 50% { transform: translate(5px,-50%); } }
        .pizza-scene.pista .flecha-izq { animation: pulsoIzq 1.1s ease-in-out 3; opacity: .95; }
        .pizza-scene.pista .flecha-der { animation: pulsoDer 1.1s ease-in-out 3; opacity: .95; }

        .capa-negra-intermedia {
            position: absolute;
            top: var(--banner-desde-arriba);
            left: 0;
            width: 100%;
            height: var(--alto-banner);
            pointer-events: none;
            z-index: 10;
        }

        .mitad-inferior-negra {
            position: absolute;
            bottom: -2%; left: 0;
            width: 100%; height: 75%;
            background: linear-gradient(
                to bottom,
                rgba(60,61,66,0) 0%,
                rgba(60,61,66,0.25) 20%,
                rgba(60,61,66,0.7) 45%,
                rgba(60,61,66,0.96) 70%,
                var(--background_color) 100%
            );
        }

        .mask-container {
            position: absolute;
            top: var(--banner-desde-arriba);
            left: 0; width: 100%;
            pointer-events: none;
            z-index: 2;
        }

        .banner-img {
            width: 100%;
            height: var(--alto-banner);
            background-image: url('img/banner.webp');
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center bottom;
            transform: scale(1.02);
            position: relative;
        }

        .banner-img::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 1;
            pointer-events: none;
            background: linear-gradient(
                to right,
                var(--background_color) 0%,
                transparent 12%,
                transparent 88%,
                var(--background_color) 100%
            );
        }

        .exceso-negro {
            width: 100%;
            background-color: var(--background_color);
            height: calc(var(--alto-escena) - var(--banner-desde-arriba) - var(--alto-banner));
        }

        .instrucciones {
            position: relative;
            margin-top: -22px;
            color: #bbb;
            font-size: clamp(0.75rem, 3.4vw, 0.9rem);
            background: rgba(0,0,0,0.6);
            backdrop-filter: blur(6px);
            -webkit-backdrop-filter: blur(6px);
            padding: 6px 18px;
            border-radius: 50px;
            pointer-events: none;
            z-index: 20;
            display: flex;
            align-items: center;
            gap: 10px;
            white-space: nowrap;
        }
        .instrucciones b { color: var(--oro); font-weight: 600; }
        @media (max-width: 400px) { .solo-ancho { display: none; } }
        .contador {
            font-variant-numeric: tabular-nums;
            color: rgba(255,255,255,0.45);
            border-left: 1px solid rgba(255,255,255,0.15);
            padding-left: 10px;
        }

        /* ── Ingredientes ── */
        .ingredientes {
            width: var(--ancho-total);
            margin: 16px auto 0;
            min-height: 1.5em;
            text-align: center;
            color: rgba(255,255,255,0.68);
            font-size: clamp(0.82rem, 3.5vw, 0.98rem);
            line-height: 1.6;
        }
        .ingredientes .ing { white-space: nowrap; }
        .ingredientes .sep { color: var(--oro); opacity: .7; margin: 0 .45em; }
        @keyframes ingEntra {
            from { opacity: 0; transform: translateY(6px); filter: blur(2px); }
            to   { opacity: 1; transform: none; filter: none; }
        }
        .ingredientes.cambiando { animation: ingEntra .35s ease both; }

        /* ── Bloque de precios ── */
        .precio-wrap {
            width: var(--ancho-total);
            max-width: var(--ancho-referencia);
            margin: 22px auto 36px;
            display: flex;
            gap: clamp(10px, 3vw, 20px);
            align-items: stretch;
        }

        .precio-card {
            flex: 1;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.09);
            border-radius: 18px;
            padding: clamp(16px, 4vw, 26px) clamp(14px, 3vw, 22px);
            display: flex;
            flex-direction: column;
            gap: 4px;
            position: relative;
            overflow: hidden;
        }

        .precio-card::before {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(ellipse at 50% -10%, rgba(243,179,61,0.08) 0%, transparent 65%);
            pointer-events: none;
        }

        .precio-card.sin-porcion { opacity: 0.55; }

        .precio-label {
            font-size: clamp(0.62rem, 1.8vw, 0.75rem);
            letter-spacing: 0.13em;
            text-transform: uppercase;
            color: rgba(255,255,255,0.35);
            font-weight: 600;
        }

        .precio-nombre {
            font-size: clamp(0.78rem, 2.4vw, 0.95rem);
            font-weight: 600;
            color: rgba(255,255,255,0.65);
            min-height: 1.3em;
            margin-top: 2px;
        }

        .precio-valor {
            display: flex;
            align-items: baseline;
            gap: 2px;
            margin-top: 6px;
        }

        .precio-num {
            font-size: clamp(1.7rem, 6.5vw, 2.6rem);
            font-weight: 800;
            color: var(--oro);
            line-height: 1;
            letter-spacing: -0.02em;
        }
        .sin-porcion .precio-num { font-size: clamp(1rem, 4vw, 1.4rem); }
        .sin-porcion .precio-euro { display: none; }

        .precio-euro {
            font-size: clamp(0.9rem, 3vw, 1.2rem);
            font-weight: 700;
            color: rgba(243,179,61,0.65);
            margin-left: 1px;
        }

        .precio-sub {
            margin-top: 6px;
            font-size: clamp(0.65rem, 1.9vw, 0.78rem);
            color: rgba(255,255,255,0.28);
            line-height: 1.4;
        }

        .sin-porcion .precio-sub { display: none; }

        .precio-sep {
            width: 1px;
            background: rgba(255,255,255,0.08);
            border-radius: 1px;
            align-self: stretch;
            flex-shrink: 0;
        }

        @keyframes numEntra {
            from { opacity: 0; transform: translateY(5px) scale(0.96); }
            to   { opacity: 1; transform: translateY(0)   scale(1);    }
        }

        .precio-num.cambiando { animation: numEntra 0.25s ease forwards; }

        @media (min-width: 1700px) {
            .hero { position: relative; }
            .precio-wrap {
                position: absolute;
                inset: 0;
                width: 100%;
                max-width: none;
                pointer-events: none;
                z-index: 30;
            }
            .precio-card {
                width: 220px;
                position: absolute;
                top: 340px;
                pointer-events: auto;
                backdrop-filter: blur(10px);
            }
            #card-porcion { left: 40px; }
            #card-entera { right: 40px; }
            .precio-sep { display: none; }
            .hero { padding-bottom: 40px; }
        }

        /* ── Secciones comunes ── */
        .seccion-cabecera {
            width: var(--ancho-total);
            margin: 0 auto 26px;
            text-align: center;
        }
        .sobretitulo {
            color: var(--oro);
            font-size: 0.72rem;
            letter-spacing: 0.28em;
            font-weight: 700;
            text-transform: uppercase;
        }
        .seccion-titulo {
            font-size: clamp(1.55rem, 5.6vw, 2.3rem);
            font-weight: 800;
            margin-top: 8px;
            letter-spacing: -0.01em;
        }
        .seccion-sub {
            color: rgba(255,255,255,0.5);
            font-size: clamp(0.88rem, 3.4vw, 1rem);
            margin-top: 8px;
            line-height: 1.5;
        }

        /* ── Reseñas ── */
        .resenas {
            width: 100%;
            padding: 44px 0 56px;
            background:
                radial-gradient(ellipse 60% 50% at 50% 0%, rgba(243,179,61,0.07), transparent 70%),
                linear-gradient(to bottom, var(--background_color), #313237);
            border-top: 1px solid rgba(255,255,255,0.06);
            scroll-margin-top: 60px;
        }

        .carrusel {
            position: relative;
            width: min(100%, 1100px);
            margin: 0 auto;
            --card: min(80vw, 340px);
        }

        .carrusel-pista {
            display: flex;
            gap: 16px;
            overflow-x: auto;
            scroll-snap-type: x mandatory;
            scroll-behavior: smooth;
            padding: 10px calc((100% - var(--card)) / 2) 18px;
            scrollbar-width: none;
            -webkit-overflow-scrolling: touch;
            -webkit-mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
                    mask-image: linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
            outline: none;
        }
        .carrusel-pista::-webkit-scrollbar { display: none; }

        .resena {
            flex: 0 0 var(--card);
            scroll-snap-align: center;
            background: linear-gradient(160deg, rgba(255,255,255,0.075), rgba(255,255,255,0.03));
            border: 1px solid rgba(255,255,255,0.09);
            border-radius: 20px;
            padding: 22px 22px 20px;
            display: flex;
            flex-direction: column;
            gap: 14px;
            opacity: 0.5;
            transform: scale(0.95);
            transition: opacity .45s ease, transform .45s ease, border-color .45s ease;
            position: relative;
        }
        .resena.activa {
            opacity: 1;
            transform: none;
            border-color: rgba(243,179,61,0.32);
        }
        .resena::after {
            content: '\201D';
            position: absolute;
            right: 18px;
            top: 4px;
            font-size: 4.5rem;
            line-height: 1;
            font-family: Georgia, serif;
            color: rgba(243,179,61,0.14);
            pointer-events: none;
        }

        .resena-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
        .estrellas { color: var(--oro); letter-spacing: 2px; font-size: 1rem; }
        .estrellas .vacia { color: rgba(255,255,255,0.18); }
        .tag-ejemplo {
            font-size: 0.6rem;
            letter-spacing: 0.14em;
            text-transform: uppercase;
            border: 1px dashed rgba(255,255,255,0.35);
            color: rgba(255,255,255,0.55);
            padding: 2px 8px;
            border-radius: 20px;
            margin-right: 34px;
        }

        .resena-texto {
            color: rgba(255,255,255,0.84);
            font-size: 0.98rem;
            line-height: 1.55;
            flex: 1;
        }

        .resena-autor { display: flex; align-items: center; gap: 12px; }
        .avatar {
            width: 38px; height: 38px;
            border-radius: 50%;
            display: grid; place-items: center;
            background: linear-gradient(135deg, #f3b33d, #d9861e);
            color: #1a1a1a;
            font-weight: 800;
            flex-shrink: 0;
        }
        .resena-autor strong { display: block; font-size: 0.92rem; }
        .resena-autor small { color: rgba(255,255,255,0.42); font-size: 0.76rem; }

        .carrusel-control {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 18px;
            margin-top: 4px;
        }
        .carrusel-btn {
            width: 40px; height: 40px;
            border-radius: 50%;
            border: 1px solid rgba(255,255,255,0.15);
            background: rgba(10,10,10,0.55);
            color: #fff;
            display: grid; place-items: center;
            cursor: pointer;
            flex-shrink: 0;
            transition: background .25s ease, color .25s ease;
        }
        .carrusel-btn:hover { background: var(--oro); color: #111; }
        .carrusel-btn svg { width: 16px; height: 16px; }
        @media (max-width: 700px) { .carrusel-btn { display: none; } }

        .carrusel-puntos {
            display: flex;
            justify-content: center;
            gap: 8px;
        }
        .carrusel-puntos button {
            width: 8px; height: 8px;
            border-radius: 8px;
            border: 0;
            background: rgba(255,255,255,0.22);
            cursor: pointer;
            padding: 0;
            transition: width .3s ease, background .3s ease;
        }
        .carrusel-puntos button.activo { width: 24px; background: var(--oro); }

        .resenas-cta { display: flex; justify-content: center; margin-top: 26px; }

        /* ── Botones ── */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 13px 24px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 0.98rem;
            text-decoration: none;
            transition: transform .2s ease, background .25s ease, color .25s ease, box-shadow .25s ease;
            -webkit-tap-highlight-color: transparent;
        }
        .btn svg { width: 19px; height: 19px; flex-shrink: 0; }
        .btn:active { transform: scale(0.97); }
        .btn-oro { background: var(--oro); color: #151515; box-shadow: 0 8px 24px rgba(243,179,61,0.25); }
        .btn-oro:hover { background: #ffc552; }
        .btn-borde { border: 1px solid rgba(243,179,61,0.55); color: var(--oro); }
        .btn-borde:hover { background: rgba(243,179,61,0.12); }
        .btn-verde { background: #25d366; color: #0b2614; }
        .btn-verde:hover { background: #3be07a; }

        /* ── Contacto ── */
        .contacto {
            width: 100%;
            padding: 56px 0 40px;
            background: #2b2c30;
            scroll-margin-top: 60px;
        }
        .contacto-caja {
            width: var(--ancho-total);
            margin: 0 auto;
            text-align: center;
        }
        .contacto-botones {
            display: flex;
            gap: 12px;
            justify-content: center;
            flex-wrap: wrap;
            margin-top: 24px;
        }
        .contacto-datos {
            list-style: none;
            display: flex;
            justify-content: center;
            flex-wrap: wrap;
            gap: 10px 28px;
            margin-top: 28px;
            color: rgba(255,255,255,0.6);
            font-size: 0.92rem;
        }
        .contacto-datos li { display: flex; align-items: center; gap: 8px; }
        .contacto-datos svg { width: 16px; height: 16px; color: var(--oro); }

        footer {
            background: #0a0a0a;
            color: rgba(255,255,255,0.35);
            text-align: center;
            font-size: 0.78rem;
            padding: 22px 20px calc(22px + env(safe-area-inset-bottom));
        }
        footer b { color: var(--oro); font-weight: 700; letter-spacing: 1px; }

        /* ── Botón flotante (móvil) ── */
        .fab-pedir {
            position: fixed;
            right: 16px;
            bottom: calc(16px + env(safe-area-inset-bottom));
            z-index: 900;
            padding: 13px 20px;
            transform: translateY(130%);
            opacity: 0;
            transition: transform .35s cubic-bezier(.2,.9,.3,1.2), opacity .3s ease;
            pointer-events: none;
        }
        .fab-pedir.visible { transform: none; opacity: 1; pointer-events: auto; }
        @media (min-width: 901px) { .fab-pedir { display: none; } }

        @media (prefers-reduced-motion: reduce) {
            html { scroll-behavior: auto; }
            .carrusel-pista { scroll-behavior: auto; }
            .pizza-scene.pista .flecha { animation: none; }
        }
    </style>
</head>
<body>

    <header class="top-menu">
        <a class="logo" href="#carta">PIZZERÍA TORRE DEL ORO</a>
        <nav>
            <a href="#carta">Carta</a>
            <a href="#opiniones">Opiniones</a>
            <a href="#contacto">Pedir</a>
        </nav>
    </header>

    <main>
