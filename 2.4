    <script>
    (function () {
        'use strict';

        /* ══════════════════════════════════════════════
           CONFIGURACIÓN — datos de la pizzería
           (si dejas un campo vacío '', ese botón/dato se oculta)
        ══════════════════════════════════════════════ */
        const CONFIG = {
            telefono:   '+34 600 000 000',          // ← CAMBIAR por el teléfono real
            whatsapp:   '34600000000',              // ← CAMBIAR: número con prefijo, sin + ni espacios
            mensajeWhatsapp: '¡Hola! Quería hacer un pedido 🍕',
            direccion:  'Dirección de la pizzería', // ← CAMBIAR
            horario:    'Horario de apertura',      // ← CAMBIAR
            urlResena:  '',                         // ← enlace "Pedir reseñas" de vuestro perfil de Google
        };

        /* ══════════════════════════════════════════════
           CARTA — el orden aquí es el orden del arco
           img: null → sale un dibujo de "foto muy pronto"
        ══════════════════════════════════════════════ */
        const PIZZAS = [
            { id: 'margherita',    nombre: 'Margherita',    precio: 9.90,  porcion: 4,    img: 'img/margherita.webp',
              ingredientes: ['Tomate', 'Mozzarella', 'Albahaca'] },
            { id: 'salvatore',     nombre: 'Salvatore',     precio: 12.00, porcion: 4,    img: 'img/salvatore.webp',
              ingredientes: ['Tomate', 'Mozzarella', 'Anchoas', 'Alcaparras', 'Orégano'] },
            { id: 'cotto',         nombre: 'Cotto',         precio: 10.50, porcion: 4,    img: null,
              ingredientes: ['Tomate', 'Mozzarella', 'Jamón cocido'] },                                  // REVISAR
            { id: 'barbacoa',      nombre: 'Barbacoa',      precio: 12.50, porcion: 4,    img: null,
              ingredientes: ['Salsa barbacoa', 'Mozzarella', 'Carne', 'Bacon', 'Cebolla'] },             // REVISAR
            { id: 'pepperoni',     nombre: 'Pepperoni',     precio: 10.50, porcion: 4,    img: 'img/pepperoni.webp',
              ingredientes: ['Tomate', 'Mozzarella', 'Pepperoni', 'Orégano'] },
            { id: 'carbonara',     nombre: 'Carbonara',     precio: 12.50, porcion: 4,    img: null,
              ingredientes: ['Nata', 'Mozzarella', 'Bacon', 'Champiñones'] },                            // REVISAR
            { id: 'tonno',         nombre: 'Tonno',         precio: 11.00, porcion: 4,    img: null,
              ingredientes: ['Tomate', 'Mozzarella', 'Atún', 'Cebolla'] },                               // REVISAR
            { id: 'calzone',       nombre: 'Calzone',       precio: 12.00, porcion: null, img: null,
              ingredientes: ['Pizza cerrada', 'Tomate', 'Mozzarella', 'Jamón cocido', 'Champiñones'] },  // REVISAR
            { id: 'vegetal',       nombre: 'Vegetal',       precio: 11.00, porcion: 4,    img: null,
              ingredientes: ['Tomate', 'Mozzarella', 'Pimiento', 'Cebolla', 'Champiñones', 'Aceitunas'] }, // REVISAR
            { id: 'torre-del-oro', nombre: 'Torre del Oro', precio: 12.50, porcion: 4,    img: 'img/torre-del-oro.webp',
              ingredientes: ['Tomate', 'Mozzarella', 'Jamón serrano', 'Rúcula', 'Tomate cherry', 'Parmesano'] },
            { id: '4-formaggi',    nombre: '4 Formaggi',    precio: 12.00, porcion: 4,    img: null,
              ingredientes: ['Mozzarella', 'Gorgonzola', 'Parmesano', 'Emmental'] },                     // REVISAR
            { id: 'dolce',         nombre: 'Dolce',         precio: 6.50,  porcion: null, img: null,
              ingredientes: ['Pizza dulce de postre'] },                                                  // REVISAR
        ];

        /* ══════════════════════════════════════════════
           RESEÑAS — pon aquí reseñas REALES de clientes
           (p. ej. copiadas de Google Maps). Las de ejemplo
           llevan ejemplo: true y salen marcadas como "Ejemplo".
        ══════════════════════════════════════════════ */
        const RESENAS = [
            { nombre: 'Cliente de ejemplo', estrellas: 5, fecha: 'hace 1 semana',  fuente: 'Google', ejemplo: true,
              texto: 'Masa fina y con el borde crujiente, de las que da gusto comer. Repetiremos seguro.' },
            { nombre: 'Cliente de ejemplo', estrellas: 5, fecha: 'hace 2 semanas', fuente: 'Google', ejemplo: true,
              texto: 'Pedimos la Torre del Oro y llegó caliente y en su punto. El jamón con la rúcula, un acierto.' },
            { nombre: 'Cliente de ejemplo', estrellas: 4, fecha: 'hace 1 mes',     fuente: 'Google', ejemplo: true,
              texto: 'Lo de poder pedir por porción está genial para comer algo rápido. Buen precio.' },
            { nombre: 'Cliente de ejemplo', estrellas: 5, fecha: 'hace 1 mes',     fuente: 'Google', ejemplo: true,
              texto: 'Trato muy amable y la pizza, de horno de verdad. Se nota en el sabor.' },
            { nombre: 'Cliente de ejemplo', estrellas: 5, fecha: 'hace 2 meses',   fuente: 'Google', ejemplo: true,
              texto: 'La Salvatore con anchoas y alcaparras es otro nivel. Muy recomendable.' },
        ];

        /* ── Utilidades ── */
        const $ = id => document.getElementById(id);
        const NS = 'http://www.w3.org/2000/svg';
        const N = PIZZAS.length;
        const clamp = (v, a, b) => Math.min(b, Math.max(a, v));
        const fmt = n => n.toFixed(2).replace('.', ',');
        const esc = s => String(s).replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        function svgEl(tag, attrs) {
            const el = document.createElementNS(NS, tag);
            for (const k in attrs) el.setAttribute(k, attrs[k]);
            return el;
        }

        /* ══════════════════════════════════════════════
           IMÁGENES DE LAS PIZZAS
        ══════════════════════════════════════════════ */
        function placeholderSVG(nombre) {
            const sl = [0, 45, 90, 135].map(a => {
                const r = a * Math.PI / 180, x = 420 * Math.cos(r), y = 420 * Math.sin(r);
                return `<line x1="${500 - x}" y1="${500 - y}" x2="${500 + x}" y2="${500 + y}"/>`;
            }).join('');
            const tops = [[350,420,26],[640,400,22],[560,215,20],[300,600,24],[700,620,26],[470,700,22],[230,360,18],[760,300,18]]
                .map(([x, y, r]) => `<circle cx="${x}" cy="${y}" r="${r}"/>`).join('');
            const svg =
                `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000">
                    <defs><radialGradient id="g" cx="50%" cy="40%" r="60%">
                        <stop offset="0" stop-color="#55565c"/><stop offset="1" stop-color="#2f3034"/>
                    </radialGradient></defs>
                    <circle cx="500" cy="500" r="492" fill="url(#g)"/>
                    <circle cx="500" cy="500" r="458" fill="none" stroke="#f3b33d" stroke-opacity=".45" stroke-width="7"/>
                    <circle cx="500" cy="500" r="424" fill="none" stroke="#f3b33d" stroke-opacity=".22" stroke-width="3" stroke-dasharray="12 16"/>
                    <g stroke="#ffffff" stroke-opacity=".07" stroke-width="3">${sl}</g>
                    <g fill="none" stroke="#f3b33d" stroke-opacity=".18" stroke-width="3">${tops}</g>
                    <rect x="210" y="225" width="580" height="170" rx="30" fill="#2f3034" fill-opacity=".72"/>
                    <text x="500" y="312" text-anchor="middle" font-family="Segoe UI, system-ui, Roboto, sans-serif"
                          font-size="${nombre.length > 10 ? 64 : 76}" font-weight="800" letter-spacing="4" fill="#f3b33d">${esc(nombre.toUpperCase())}</text>
                    <text x="500" y="368" text-anchor="middle" font-family="Segoe UI, system-ui, Roboto, sans-serif"
                          font-size="30" letter-spacing="8" fill="#ffffff" fill-opacity=".55">FOTO MUY PRONTO</text>
                </svg>`;
            return 'data:image/svg+xml;charset=utf-8,' + encodeURIComponent(svg);
        }

        const container = $('pizzaContainer');
        const pizzas = PIZZAS.map((p, i) => {
            const img = document.createElement('img');
            img.src = p.img || placeholderSVG(p.nombre);
            img.alt = p.nombre;
            img.draggable = false;
            img.decoding = 'async';
            if (i === 0) img.fetchPriority = 'high';
            img.onerror = () => { img.onerror = null; img.src = placeholderSVG(p.nombre); };
            container.appendChild(img);
            return img;
        });

        /* ══════════════════════════════════════════════
           PRECIOS E INGREDIENTES
        ══════════════════════════════════════════════ */
        const cardPorcion   = $('card-porcion');
        const numPorcion    = $('num-porcion');
        const nombrePorcion = $('nombre-porcion');
        const numEntera     = $('num-entera');
        const nombreEntera  = $('nombre-entera');
        const ingEl         = $('ingredientes');
        const contador      = $('contador');

        function reanimar(el, cls) {
            el.classList.remove(cls);
            void el.offsetWidth;
            el.classList.add(cls);
        }

        function actualizarInfo(idx) {
            const p = PIZZAS[idx];
            nombreEntera.textContent = p.nombre;
            numEntera.textContent = fmt(p.precio);
            reanimar(numEntera, 'cambiando');

            if (!p.porcion) {
                cardPorcion.classList.add('sin-porcion');
                nombrePorcion.textContent = '';
                numPorcion.textContent = 'No disponible';
            } else {
                cardPorcion.classList.remove('sin-porcion');
                nombrePorcion.textContent = p.nombre;
                numPorcion.textContent = fmt(p.porcion);
            }
            reanimar(numPorcion, 'cambiando');

            ingEl.innerHTML = p.ingredientes.map(t => `<span class="ing">${esc(t)}</span>`).join('<span class="sep">·</span>');
            reanimar(ingEl, 'cambiando');
            contador.textContent = `${idx + 1}/${N}`;
        }

        /* ══════════════════════════════════════════════
           ARCO / RUEDA DE NOMBRES
           · Pantalla ancha  → arco fijo con todas, el punto viaja
           · Móvil / tablet  → rueda: la pizza activa siempre arriba
             en el centro y los nombres giran con la pizza
        ══════════════════════════════════════════════ */
        const svg      = $('arc-svg');
        const arcWrap  = $('arcWrap');
        const arcRoot  = $('arc-root');
        const arcPath  = $('arc-path');
        const labelsG  = $('arc-labels');
        const arcDot   = $('arc-dot');
        const maskRect = $('arc-mask-rect');
        const scene    = $('pizzaScene');
        const FUENTE   = "'Segoe UI', system-ui, -apple-system, Roboto, sans-serif";
        const medidor  = document.createElement('canvas').getContext('2d');

        function anchoTexto(t, fs, ls) {
            medidor.font = `700 ${fs}px ${FUENTE}`;
            return medidor.measureText(t).width + ls * t.length;
        }

        function partirNombre(nombre, fs, ls, maxW) {
            const up = nombre.toUpperCase();
            if (anchoTexto(up, fs, ls) <= maxW) return [up];
            const w = up.split(' ');
            if (w.length < 2) return [up];
            let mejor = [up], mejorW = Infinity;
            for (let c = 1; c < w.length; c++) {
                const a = w.slice(0, c).join(' '), b = w.slice(c).join(' ');
                const m = Math.max(anchoTexto(a, fs, ls), anchoTexto(b, fs, ls));
                if (m < mejorW) { mejorW = m; mejor = [a, b]; }
            }
            return mejor;
        }

        let geo = null;
        let items = [];
        let currentIndex = 0;
        let ringPos = 0;      // posición continua de la rueda (sin envolver)
        let dotPos = 0;       // posición continua del punto (modo fijo)

        function kDe(i, ring) {
            if (geo.modo === 'fijo') return i - (N - 1) / 2;
            let k = ((i - ring) % N + N) % N;
            if (k >= N / 2) k -= N;
            return k;
        }

        function punto(k) {
            const th = k * geo.delta;
            return { x: geo.cx + geo.r * Math.sin(th), y: geo.cy - geo.r * Math.cos(th) };
        }

        function calcularGeo() {
            const W = Math.max(280, Math.round(arcWrap.clientWidth));
            const modo = W >= 860 ? 'fijo' : 'rueda';
            const fs   = modo === 'fijo' ? clamp(W * 0.0135, 13, 15.5) : clamp(W * 0.033, 11.5, 14);
            const fsA  = fs * 1.18;
            const ls   = modo === 'fijo' ? 1 : 0.6;
            const lineH = fsA * 1.18;
            const r     = modo === 'fijo' ? W * 0.78 : W * 0.95;
            const kEdge = modo === 'fijo' ? (N - 1) / 2 : (W < 360 ? 2.6 : 3);
            const reach = modo === 'fijo' ? W * 0.41 : W * 0.47;
            const delta = Math.asin(Math.min(reach / r, 0.98)) / kEdge;
            const dotR  = clamp(W * 0.0095, 4.5, 8.5);
            const fuera = fs * 1.15, dentro = fs * 0.9;
            const slot  = r * delta;
            const maxW  = 2 * slot * (modo === 'fijo' ? 0.9 : 1.15) - 8;
            const lineas = PIZZAS.map(p => partirNombre(p.nombre, fsA, ls, maxW));
            const maxLin = Math.max(...lineas.map(l => l.length));
            const topY = Math.ceil(dotR * 1.8 + fuera + maxLin * lineH + 4);
            const sceneW = scene.clientWidth;
            return { W, modo, fs, fsA, ls, lineH, r, kEdge, delta, dotR, fuera, dentro, slot, lineas,
                     topY, cx: W / 2, cy: topY + r, pizzaR: sceneW / 2 * 0.985 };
        }

        function construirArco() {
            geo = calcularGeo();
            const g = geo;

            /* Altura del SVG y hueco hasta la pizza (para que nada la pise) */
            const caidaPizza = dx => Math.abs(dx) >= g.pizzaR ? 1e9 : g.pizzaR - Math.sqrt(g.pizzaR * g.pizzaR - dx * dx);
            const muestras = [];
            PIZZAS.forEach((p, i) => {
                if (g.modo === 'fijo') muestras.push({ i, k: kDe(i, 0) });
                else for (let k = -g.kEdge; k <= g.kEdge + 0.001; k += 0.25) muestras.push({ i, k });
            });
            let pizzaTop = g.topY + g.dotR * 3;
            let maxY = g.topY + g.dotR * 2;
            muestras.forEach(({ i, k }) => {
                const pt = punto(k);
                const abajo = i % 2 === 1;
                const bottom = abajo
                    ? pt.y + g.dotR * 1.8 + g.dentro + g.lineas[i].length * g.lineH + 2
                    : pt.y + g.dotR * 1.5;
                maxY = Math.max(maxY, bottom);
                if (abajo) pizzaTop = Math.max(pizzaTop, bottom + 8 - caidaPizza(pt.x - g.cx));
            });
            const kArco = g.modo === 'fijo' ? (N - 1) / 2 + 0.45 : g.kEdge + 0.9;
            maxY = Math.max(maxY, punto(kArco).y + 2);
            const H = Math.ceil(maxY + 4);
            pizzaTop = Math.ceil(pizzaTop);

            svg.setAttribute('viewBox', `0 0 ${g.W} ${H}`);
            svg.setAttribute('height', H);
            svg.style.setProperty('--fs', g.fs + 'px');
            svg.style.setProperty('--fsA', g.fsA + 'px');
            arcWrap.style.marginBottom = -(H - pizzaTop) + 'px';

            /* Línea del arco */
            const p0 = punto(-kArco), p1 = punto(kArco);
            arcPath.setAttribute('d', `M ${p0.x.toFixed(1)},${p0.y.toFixed(1)} A ${g.r},${g.r} 0 0 1 ${p1.x.toFixed(1)},${p1.y.toFixed(1)}`);

            /* Difuminado de los extremos en modo rueda */
            if (g.modo === 'rueda') {
                maskRect.setAttribute('x', 0); maskRect.setAttribute('y', -60);
                maskRect.setAttribute('width', g.W); maskRect.setAttribute('height', H + 120);
                arcRoot.setAttribute('mask', 'url(#arc-mask)');
            } else {
                arcRoot.removeAttribute('mask');
            }

            /* Etiquetas */
            labelsG.textContent = '';
            items = PIZZAS.map((p, i) => {
                const abajo = i % 2 === 1;
                const lin = g.lineas[i];
                const dir = abajo ? 1 : -1;
                const y1 = dir * g.dotR * 1.8;
                const y2 = dir * (g.dotR * 1.8 + (abajo ? g.dentro : g.fuera));
                const bloque = lin.length * g.lineH;
                const hw = Math.max(22, Math.max(...lin.map(l => anchoTexto(l, g.fsA, g.ls))) / 2 + 8);

                const grupo = svgEl('g', { class: 'arc-item', role: 'button', tabindex: '0', 'aria-label': p.nombre });
                const yTop = abajo ? -g.dotR * 2 : y2 - bloque - 6;
                const yBot = abajo ? y2 + bloque + 6 : g.dotR * 2;
                const alto = Math.max(yBot - yTop, 44);
                grupo.appendChild(svgEl('rect', { x: -hw, y: abajo ? yTop : yBot - alto, width: hw * 2, height: alto, fill: 'transparent' }));
                grupo.appendChild(svgEl('line', { class: 'guia', x1: 0, y1, x2: 0, y2, 'stroke-width': 0.8, 'stroke-dasharray': '3 2' }));
                grupo.appendChild(svgEl('circle', { class: 'nodo', cx: 0, cy: 0, r: g.dotR }));

                const text = svgEl('text', { 'text-anchor': 'middle', 'font-family': FUENTE, 'letter-spacing': g.ls });
                const primera = abajo ? y2 + g.fsA * 0.95 : y2 - g.fsA * 0.3 - (lin.length - 1) * g.lineH;
                lin.forEach((linea, li) => {
                    const ts = svgEl('tspan', { x: 0, y: (primera + li * g.lineH).toFixed(1) });
                    ts.textContent = linea;
                    text.appendChild(ts);
                });
                grupo.appendChild(text);

                grupo.addEventListener('click', e => { e.stopPropagation(); irAPizza(i); });
                grupo.addEventListener('keydown', e => {
                    if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); irAPizza(i); }
                });
                labelsG.appendChild(grupo);
                return { g: grupo, visible: true };
            });

            arcDot.setAttribute('r', (g.dotR * 1.45).toFixed(1));
            marcarActivo(currentIndex);
            pintarArco(ringPos, dotPos);
        }

        function marcarActivo(idx) {
            items.forEach((it, i) => {
                it.g.classList.toggle('activo', i === idx);
                it.g.setAttribute('aria-current', i === idx ? 'true' : 'false');
            });
        }

        function pintarArco(ring, dot) {
            items.forEach((it, i) => {
                const k = kDe(i, ring);
                const pt = punto(k);
                it.g.setAttribute('transform', `translate(${pt.x.toFixed(2)} ${pt.y.toFixed(2)})`);
                if (geo.modo === 'rueda') {
                    const op = clamp((geo.kEdge + 0.25 - Math.abs(k)) / 1.1, 0, 1);
                    it.g.style.opacity = op.toFixed(3);
                    const vis = op > 0.3;
                    if (vis !== it.visible) {
                        it.visible = vis;
                        it.g.style.pointerEvents = vis ? '' : 'none';
                        it.g.setAttribute('tabindex', vis ? '0' : '-1');
                    }
                } else if (!it.visible || it.g.style.opacity) {
                    it.visible = true;
                    it.g.style.opacity = '';
                    it.g.style.pointerEvents = '';
                    it.g.setAttribute('tabindex', '0');
                }
            });
            const pd = punto(geo.modo === 'fijo' ? dot - (N - 1) / 2 : 0);
            arcDot.setAttribute('cx', pd.x.toFixed(2));
            arcDot.setAttribute('cy', pd.y.toFixed(2));
        }

        let arcAnim = null;
        function animarArco(ringDesde, ringHasta, dotDesde, dotHasta, dur) {
            if (arcAnim) cancelAnimationFrame(arcAnim);
            const t0 = performance.now();
            const ease = t => t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
            function step(now) {
                const t = Math.min((now - t0) / dur, 1);
                const e = ease(t);
                pintarArco(ringDesde + (ringHasta - ringDesde) * e, dotDesde + (dotHasta - dotDesde) * e);
                if (t < 1) arcAnim = requestAnimationFrame(step);
                else arcAnim = null;
            }
            arcAnim = requestAnimationFrame(step);
        }

        /* ══════════════════════════════════════════════
           NAVEGACIÓN
        ══════════════════════════════════════════════ */
        let rotation  = 0;
        let animating = false;
        let pendiente = 0;          // toques guardados si tocas mientras gira (+ adelante / − atrás)
        const DURACION = 800;
        const SWAP_EN  = 0.5;

        function irAPizza(targetIndex, direccion) {
            if (animating) return;
            if (targetIndex === currentIndex) return;
            animating = true;

            const adelante = ((targetIndex - currentIndex) + N) % N;
            let pasos;
            if (direccion === 1) pasos = adelante;
            else if (direccion === -1) pasos = adelante - N;
            else pasos = adelante <= N - adelante ? adelante : adelante - N;

            const vueltas = Math.min(Math.abs(pasos), 2);
            rotation += 360 * vueltas * Math.sign(pasos);
            container.style.transition = reduceMotion ? 'none' : `transform ${DURACION}ms cubic-bezier(0.65, 0, 0.35, 1)`;
            container.style.transform  = `rotate(${rotation}deg)`;

            const dur = reduceMotion ? 1 : DURACION;
            animarArco(ringPos, ringPos + pasos, currentIndex, targetIndex, dur);
            ringPos += pasos;
            dotPos = targetIndex;

            setTimeout(() => {
                pizzas[currentIndex].classList.remove('active');
                currentIndex = targetIndex;
                pizzas[currentIndex].classList.add('active');
                marcarActivo(currentIndex);
                actualizarInfo(currentIndex);
                precargarVecinas(currentIndex);
                try { history.replaceState(null, '', '#' + PIZZAS[currentIndex].id); } catch (e) {}
            }, dur * SWAP_EN);

            setTimeout(() => {
                animating = false;
                container.style.transition = '';
                if (pendiente) {
                    const d = Math.sign(pendiente);
                    pendiente -= d;
                    irAPizza((currentIndex + d + N) % N, d);
                }
            }, dur + 20);
        }

        function paso(dir) {
            if (animating) {
                if (Math.sign(pendiente) !== dir) pendiente = 0;   // cambio de sentido: anula lo anterior
                pendiente = clamp(pendiente + dir, -3, 3);
                return;
            }
            if (navigator.vibrate) { try { navigator.vibrate(8); } catch (e) {} }
            irAPizza((currentIndex + dir + N) % N, dir);
        }

        function precargarVecinas(i) {
            [i - 1, i + 1].forEach(j => {
                const img = pizzas[(j + N) % N];
                if (img.decode) img.decode().catch(() => {});
            });
        }

        /* Toque en la pizza: mitad izquierda = anterior, derecha = siguiente.
           También vale deslizar el dedo. */
        const clip = $('pizzaClip');
        let toqueX = 0, toqueY = 0, deslizo = false;

        clip.addEventListener('touchstart', e => {
            const t = e.touches[0];
            toqueX = t.clientX; toqueY = t.clientY; deslizo = false;
        }, { passive: true });

        clip.addEventListener('touchend', e => {
            const t = e.changedTouches[0];
            const dx = t.clientX - toqueX, dy = t.clientY - toqueY;
            if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.3) {
                deslizo = true;
                paso(dx < 0 ? 1 : -1);
            }
        }, { passive: true });

        clip.addEventListener('click', e => {
            e.stopPropagation();
            if (deslizo) { deslizo = false; return; }
            const r = clip.getBoundingClientRect();
            paso(e.clientX - r.left < r.width / 2 ? -1 : 1);
        });

        clip.addEventListener('mousemove', e => {
            const r = clip.getBoundingClientRect();
            const izq = e.clientX - r.left < r.width / 2;
            scene.classList.toggle('lado-izq', izq);
            scene.classList.toggle('lado-der', !izq);
        });
        clip.addEventListener('mouseleave', () => scene.classList.remove('lado-izq', 'lado-der'));
        container.addEventListener('dragstart', e => e.preventDefault());

        $('btnPrev').addEventListener('click', e => { e.stopPropagation(); paso(-1); });
        $('btnNext').addEventListener('click', e => { e.stopPropagation(); paso(1); });

        document.addEventListener('keydown', e => {
            if (e.target.closest && e.target.closest('.carrusel, input, textarea')) return;
            if (e.key === 'ArrowLeft')  paso(-1);
            if (e.key === 'ArrowRight') paso(1);
        });

        /* ── Inicio ── */
        (function init() {
            const desdeHash = PIZZAS.findIndex(p => '#' + p.id === decodeURIComponent(location.hash));
            if (desdeHash > 0) { currentIndex = ringPos = dotPos = desdeHash; }
            pizzas[currentIndex].classList.add('active');
            container.style.transition = 'none';
            container.style.transform = 'rotate(0deg)';

            construirArco();
            actualizarInfo(currentIndex);

            if (document.fonts && document.fonts.ready) document.fonts.ready.then(construirArco);

            /* Enlaces del tipo index.html#pepperoni abren esa pizza */
            window.addEventListener('hashchange', () => {
                const i = PIZZAS.findIndex(p => '#' + p.id === decodeURIComponent(location.hash));
                if (i >= 0 && i !== currentIndex) irAPizza(i);
            });

            let anchoPrevio = window.innerWidth, resizeTimer;
            window.addEventListener('resize', () => {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(() => {
                    if (window.innerWidth === anchoPrevio) return;   // la barra del móvil no cuenta
                    anchoPrevio = window.innerWidth;
                    construirArco();
                }, 80);
            });

            window.addEventListener('load', () => {
                pizzas.forEach(img => img.decode && img.decode().catch(() => {}));
                /* Pequeña pista animada de las flechas, solo la primera visita */
                let visto = false;
                try { visto = localStorage.getItem('tdo-pista') === '1'; } catch (e) {}
                if (!visto && !reduceMotion) {
                    setTimeout(() => scene.classList.add('pista'), 900);
                    setTimeout(() => scene.classList.remove('pista'), 4500);
                    try { localStorage.setItem('tdo-pista', '1'); } catch (e) {}
                }
            });
        })();

        /* ══════════════════════════════════════════════
           RESEÑAS — carrusel con auto-avance
        ══════════════════════════════════════════════ */
        (function resenas() {
            const pista  = $('resPista');
            const puntos = $('resPuntos');
            if (!RESENAS.length) { $('opiniones').style.display = 'none'; return; }

            pista.innerHTML = RESENAS.map(r => {
                const n = clamp(Math.round(r.estrellas || 5), 0, 5);
                const est = '★'.repeat(n) + `<span class="vacia">${'★'.repeat(5 - n)}</span>`;
                const meta = [r.fuente, r.fecha].filter(Boolean).map(esc).join(' · ');
                return `
                <article class="resena">
                    <div class="resena-top">
                        <span class="estrellas" aria-label="${n} de 5 estrellas">${est}</span>
                        ${r.ejemplo ? '<span class="tag-ejemplo">Ejemplo</span>' : ''}
                    </div>
                    <p class="resena-texto">${esc(r.texto)}</p>
                    <div class="resena-autor">
                        <span class="avatar">${esc((r.nombre || '?').trim().charAt(0).toUpperCase())}</span>
                        <div><strong>${esc(r.nombre)}</strong><small>${meta}</small></div>
                    </div>
                </article>`;
            }).join('');

            const cards = [...pista.children];
            puntos.innerHTML = cards.map((_, i) => `<button aria-label="Ver reseña ${i + 1}"></button>`).join('');
            const dots = [...puntos.children];
            let actual = -1;

            function marcar(i) {
                if (i === actual) return;
                actual = i;
                cards.forEach((c, j) => c.classList.toggle('activa', j === i));
                dots.forEach((d, j) => d.classList.toggle('activo', j === i));
            }

            function irA(i) {
                const c = cards[(i + cards.length) % cards.length];
                pista.scrollTo({ left: c.offsetLeft - (pista.clientWidth - c.offsetWidth) / 2 });
            }

            function cercana() {
                const centro = pista.scrollLeft + pista.clientWidth / 2;
                let mejor = 0, dist = Infinity;
                cards.forEach((c, i) => {
                    const d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - centro);
                    if (d < dist) { dist = d; mejor = i; }
                });
                return mejor;
            }

            let raf = 0;
            pista.addEventListener('scroll', () => {
                cancelAnimationFrame(raf);
                raf = requestAnimationFrame(() => marcar(cercana()));
            }, { passive: true });

            /* Auto-avance: se para si el usuario toca, y vuelve a los 7 s */
            const INTERVALO = 5000;
            let enPantalla = false, pausaHasta = 0, encima = false;
            const pausar = () => { pausaHasta = Date.now() + 7000; };

            setInterval(() => {
                if (reduceMotion || !enPantalla || encima || document.hidden || Date.now() < pausaHasta) return;
                irA(actual + 1 >= cards.length ? 0 : actual + 1);
            }, INTERVALO);

            ['pointerdown', 'touchstart', 'wheel', 'keydown'].forEach(ev =>
                pista.addEventListener(ev, pausar, { passive: true }));
            pista.addEventListener('mouseenter', () => { encima = true; });
            pista.addEventListener('mouseleave', () => { encima = false; });

            dots.forEach((d, i) => d.addEventListener('click', () => { pausar(); irA(i); }));
            $('resPrev').addEventListener('click', () => { pausar(); irA(actual - 1); });
            $('resNext').addEventListener('click', () => { pausar(); irA(actual + 1); });
            pista.addEventListener('keydown', e => {
                if (e.key === 'ArrowLeft')  { e.preventDefault(); irA(actual - 1); }
                if (e.key === 'ArrowRight') { e.preventDefault(); irA(actual + 1); }
            });

            if ('IntersectionObserver' in window) {
                new IntersectionObserver(es => { enPantalla = es[0].isIntersecting; }, { threshold: 0.4 }).observe(pista);
            } else {
                enPantalla = true;
            }

            marcar(0);
            requestAnimationFrame(() => {
                pista.style.scrollBehavior = 'auto';
                irA(0);
                pista.style.scrollBehavior = '';
            });
            window.addEventListener('resize', () => irA(actual));
        })();

        /* ══════════════════════════════════════════════
           CONTACTO
        ══════════════════════════════════════════════ */
        (function contacto() {
            const llamar = $('btnLlamar'), wa = $('btnWhatsapp'), fab = $('fabPedir');
            const tel = CONFIG.telefono.replace(/[^\d+]/g, '');
            if (tel) {
                llamar.href = 'tel:' + tel;
                $('txtLlamar').textContent = 'Llamar · ' + CONFIG.telefono;
            } else {
                llamar.style.display = 'none';
            }
            if (CONFIG.whatsapp) {
                wa.href = `https://wa.me/${CONFIG.whatsapp}?text=${encodeURIComponent(CONFIG.mensajeWhatsapp)}`;
            } else {
                wa.style.display = 'none';
            }
            const dir = $('datoDireccion'), hor = $('datoHorario');
            if (CONFIG.direccion) dir.querySelector('span').textContent = CONFIG.direccion; else dir.style.display = 'none';
            if (CONFIG.horario)   hor.querySelector('span').textContent = CONFIG.horario;   else hor.style.display = 'none';

            const btnRes = $('btnResena');
            btnRes.href = CONFIG.urlResena ||
                'https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent('Pizzería Torre del Oro');

            $('anio').textContent = new Date().getFullYear();

            /* Botón flotante "Pedir": aparece al bajar, se esconde al llegar a contacto */
            if (tel) fab.href = 'tel:' + tel;
            let contactoVisible = false;
            const refrescar = () => fab.classList.toggle('visible', window.scrollY > 260 && !contactoVisible);
            if ('IntersectionObserver' in window) {
                new IntersectionObserver(es => { contactoVisible = es[0].isIntersecting; refrescar(); }, { threshold: 0.15 })
                    .observe($('contacto'));
            }
            window.addEventListener('scroll', refrescar, { passive: true });
            refrescar();
        })();

    })();
    </script>
</body>
</html>
